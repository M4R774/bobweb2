# Keep local state, secrets and VCS data out of the build context
.git
.github
.claude
.idea
.vscode
.env
.env.*
!.env.example

# Local database, collected static files and generated files
**/*.sqlite3
**/*.sqlite3-journal
**/staticfiles
**/*.session
**/*.session-journal
**/*.log
backups

# Python caches and test artifacts
**/__pycache__
**/*.py[cod]
.pytest_cache
.coverage*
coverage.xml
htmlcov
venv
.venv

# Not needed in the image
Dockerfile
docker-compose*.yml
.dockerignore
deploy.*
run_tests_in_container.sh
README.md
LICENSE
utilities
sonar-project.properties
